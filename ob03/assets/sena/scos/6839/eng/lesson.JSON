t": "", "type": "text"}], "id": 0, "correct": 0, "selected": 0}, {"_data": [{"content": "", "type": "text"}], "id": 1, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "id": 0, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn11le04ob03re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Read up on accidental discoveries.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn11le04ob03re2aud01", "coverimg": "engenn11le04ob03re2img01.jpg", "images": [{"image": "engenn11le04ob03re2img01.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn11le04ob03re2img01.jpg", "text": "If you haven't heard of Wilhelm Conrad R\u00f6ntgen, I'm telling you about him now. He was working in his laboratory expecting to find one thing when he discovered another. Let's go back to that day \u2026\nHe's going to cover an electric bulb with black paper for an experiment if he hasn't already. There. Now if he's  switched it on, you can see dancing lights on the table. If you've looked closely, you're seeing the light reflecting from a piece of paper covered with metal salts!", "time": "100", "id": 1}, {"image": "engenn11le04ob03re2img02.jpg", "text": "If you've seen the professor hold the paper up to the lamp and placed a book, a pack of cards, a piece of wood, and a door key between it and the lamp, you'll be aware that the rays from the lamp went through everything but the key. Now he has asked his wife to place her hand on a photographic plate. She agrees standing still is best, and he shines the black lamp on her hand for several minutes. Imagine watching the photograph develop, showing only the bones of her hand and a ring on her finger!  If you've guessed he's discovering \"the Unknown\" or X-ray, you'd be right!", "time": "30000", "id": 2}, {"image": "engenn11le04ob03re2img03.jpg", "text": "I admit liking to read about such historic things. I do it all the time. I enjoy finding out how things come to be. When a question comes up I am forced to look it up online. Sometimes it's challenging to find an answer. When this happens I stop in at the library and haul out the old tomes that keep such things for us. I'll search for anything if I've got time. If I've failed to find the answer in one publication, I'm soon moving to the next. I hope to keep unearthing new and intriguing facts. I'll invite you along next time if you've found this as stimulating as I do.", "time": "66000", "id": 3}]}}], "id": 1}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Science or Science Fiction?", "type": "lesson_name"}, {"content": "An Accidental Discovery", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 4, "type": "lesson"}, {"content": "B2.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Exchange information about unlikely events or fairly certain conditions that will be fulfilled in present, past or future  in spoken or written texts and in work and social contexts.", "type": "primary"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_7"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"content": "engenn11le04ob03re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " The Real Conditional: Conditional Connections", "type": "heading"}, {"content": " The Real Conditional can be used to connect actions and consequences together. You can talk about possible future event with a Present Perfect verb in the if-clause and a future form in the main clause.", "type": "describer"}, {"content": "If you haven't heard of Wilhelm Conrad R\u00f6ntgen, I'm telling you about him now.", "type": "example"}, {"content": "You use the Real Conditional to talk about events that are likely to happen if a condition is met, or situations that are always true if an action is or isn't completed.", "type": "text"}, {"content": " You can use a verb in the Present Perfect with the if-clause to suggest that the action needs to be completed.", "type": "text"}, {"content": "Structure: <br> If + Present/Present Perfect \u2026 Future form (will, present continuous, be going to)", "type": "text"}, {"content": "Example: <br> <span class=\"italic\">If I've failed to find the answer in one publication, I'm soon moving to the next.</span>", "type": "text"}, {"content": "He's going to cover an electric bulb with black paper for an experiment if he hasn't already. ", "type": "example"}, {"content": "Now if he's  switched it on, you can see dancing lights on the table. ", "type": "example"}, {"content": "If you've looked closely, you're seeing the light reflecting from a piece of paper covered with metal salts!", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Verbs Followed by -ing and To-Infinitives", "type": "heading"}, {"content": " When you talk about two actions linked together, you normally use two verbs. The first verb follows the rules of conjugation for the sentence, while the second verb can be a verb in the -ing form or to + Infinitive.", "type": "describer"}, {"content": "He was working in his laboratory <span class=\"strong\">expecting to find</span> one thing when when he discovered another.", "type": "example"}, {"content": "You can use two verbs to talk about two connected actions. The main verb introduces the main action, and the second verb in the -ing form gives more information about that action.", "type": "text"}, {"content": "Verbs followed by -ing are <span class=\"italic\">imagine, enjoy, consider, mind, keep, love/hate</span>.", "type": "text"}, {"content": "Verbs followed by to + Infinitive are <span class=\"italic\"> ask, promise, agree, expect</span>.", "type": "text"}, {"content": "Some verbs can be followed by either an -ing verb or to + Infinitive like <span class=\"italic\"> like, love, hate, dislike,  intend</span>.", "type": "text"}, {"content": "Structure: <br> Subject + first verb + -ing form of the second verb/to + Infinitive", "type": "text"}, {"content": "Look at some examples from the text:", "type": "text"}, {"content": "Now he has <span class=\"strong\">asked his wife to place</span> her hand on a photographic plate. ", "type": "example"}, {"content": "She <span class=\"strong\">agrees to stand still</span>, and he shines the black lamp on her hand for several minutes.", "type": "example"}, {"content": "<span class=\"strong\">Imagine watching </span>the photograph develop, showing only the bones of her hand and a ring on her finger! ", "type": "example"}, {"content": "I <span class=\"strong\">admit liking to read</span> about such historic things.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "laboratory ", "type": "name"}, {"content": "a room for scientific research", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He was working in his laboratory expecting to find one thing when he discovered another.", "type": "example"}, {"content": "engenn11le04ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about a discovery.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "metal salts", "type": "name"}, {"content": "salts produced by immersing metal in acid", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: If you've looked closely, you're seeing the lights reflecting from a piece of paper covered with metal salts!", "type": "example"}, {"content": "engenn11le04ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to go through", "type": "name"}, {"content": "to go in one side and out the other", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The ray went through everything but the key.", "type": "example"}, {"content": "engenn11le04ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to stand still", "type": "name"}, {"content": "to not move", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: She agrees to stand still, and he shines the black lamp on her hand for several minutes.", "type": "example"}, {"content": "engenn11le04ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to develop", "type": "name"}, {"content": "to treat with chemicals to make a photograph", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Imagine watching the photograph develop, showing only the bones of her hand and a ring on her finger! ", "type": "example"}, {"content": "engenn11le04ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "x-ray", "type": "name"}, {"content": "radiation that can go through \u200bsolid \u200bsubstances", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: If you've guessed he's discovering \"the Unknown\" or X-ray, you'd be right!", "type": "example"}, {"content": "engenn11le04ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to haul ", "type": "name"}, {"content": "to pull something heavy", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: When this happens I stop in at the library and haul out the old tomes that keep such things for us.", "type": "example"}, {"content": "engenn11le04ob03aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tome ", "type": "name"}, {"content": "a large, heavy book", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: When this happens I stop in at the library and haul out the old tomes that keep such things for us.", "type": "example"}, {"content": "engenn11le04ob03aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to unearth", "type": "name"}, {"content": "to discover information after careful searching", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I hope to keep unearthing new and intriguing facts.", "type": "example"}, {"content": "engenn11le04ob03aud09", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Go online or to the library and find out about 3 accidental discoveries that interest you.", "type": "text"}, {"content": "Find out the who, what, where, why, when and how of the discoveries.", "type": "text"}, {"content": "Write a brief summary for each and practice talking about them.", "type": "text"}, {"content": "Present your accidental discoveries to a partner or group.", "type": "text"}, {"content": "Listen to other discoveries.", "type": "text"}, {"content": "Discuss which you think are the most surprising and why.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I find out about 3 accidental discoveries.", "type": "text"}, {"content": "I summarize  the who, what, where, why, when and how of the discoveries.", "type": "text"}, {"content": "I present my discoveries and discuss them.", "type": "text"}]}]}